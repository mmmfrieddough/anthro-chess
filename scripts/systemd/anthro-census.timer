[Unit]
Description=Ask the source about more accounts when its daily window reopens

[Timer]
# The source's daily allowance is a fixed window anchored to the first request
# that opens it, which this unit reaches about a minute after it starts. So the
# firing that spent the allowance yesterday is always slightly too early to
# spend it today, and the run walks forward by one firing interval a day. That
# drift is what the interval buys down, and it is why this fires far more often
# than the allowance refills: the firings landing inside the window cost one
# refused request each, which charges nothing and does not push the window out.
OnCalendar=hourly
# The census accrues rather than finishing, so a machine that was off overnight
# runs the missed firing when it comes back rather than skipping it silently.
Persistent=true

[Install]
WantedBy=timers.target
