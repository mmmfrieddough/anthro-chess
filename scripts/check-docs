#!/usr/bin/env bash
# Repository invariants that need no Python environment: the agent guide's
# command list, and the decision records' numbering and cross-references.
#
# Continuous integration runs this same script, so a local pass and the CI step
# cannot disagree. Errors print as GitHub workflow annotations, which are plain
# text anywhere else.

set -uo pipefail

cd "$(dirname "$0")/.."

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fail=0
err() {
	printf '::error file=%s::%s\n' "$1" "$2" >&2
	fail=1
}

# --- The agent guide names commands CI actually runs -------------------------

check_agent_guide() {
	[ -f AGENTS.md ] || return 0

	for heading in '## Commands' '## Where to look' '## Traps' '## Working here'; do
		grep -qxF -- "$heading" AGENTS.md ||
			err AGENTS.md "missing heading $heading"
	done

	sed 's/^[[:space:]]*//; s/^run:[[:space:]]*//; s/[[:space:]]*$//' \
		.github/workflows/ci.yml >"$tmp/ci-cmds"

	sed -n '/^```console agent-commands$/,/^```$/{//!p}' AGENTS.md |
		sed 's/[[:space:]]*#.*//; s/[[:space:]]*$//' | grep . >"$tmp/ag-cmds" || {
		err AGENTS.md "no non-empty 'console agent-commands' block"
		return 0
	}

	while read -r cmd; do
		grep -qxF -- "$cmd" "$tmp/ci-cmds" ||
			err AGENTS.md "names a command CI does not run: $cmd"
	done <"$tmp/ag-cmds"

	printf '%s\n' \
		'uv lock --check' \
		'uv run ruff format --check .' \
		'uv run ruff check .' \
		'uv run mypy src tests' \
		'uv run pytest' >"$tmp/req-cmds"

	while read -r cmd; do
		grep -qxF -- "$cmd" "$tmp/ag-cmds" ||
			err AGENTS.md "no longer names a command CI requires: $cmd"
	done <"$tmp/req-cmds"

	if grep -nE '`(anthro-uci|anthro) [^`]*`' AGENTS.md; then
		err AGENTS.md "bare console script above needs the 'uv run' prefix"
	fi
}

# --- Decision record numbers are unique --------------------------------------

check_decision_numbers() {
	local dupes
	dupes="$(ls docs/decisions | sed -n 's/^\([0-9]\{4\}\)-.*/\1/p' | sort | uniq -d)"
	[ -n "$dupes" ] || return 0
	for number in $dupes; do
		err docs/decisions \
			"number $number is used by: $(ls docs/decisions/"$number"-* | tr '\n' ' ')"
	done
}

# --- Decision record cross-references are two-way -----------------------------

status_section() { sed -n '/^## Status$/,/^## /p' "$1"; }

check_decision_cross_references() {
	local file source target number
	for file in docs/decisions/*.md; do
		source="$(basename "$file" .md)"

		for target in $(status_section "$file" |
			grep -oE '0[0-9]{3}-[a-z0-9-]+' | sort -u); do
			if [ "$target" = "$source" ]; then
				continue
			fi
			if [ ! -f "docs/decisions/$target.md" ]; then
				err "$file" "Status names $target, which is not a decision record"
				continue
			fi
			status_section "docs/decisions/$target.md" | grep -qF "$source" ||
				err "docs/decisions/$target.md" \
					"$source names this record in its Status; add the matching line here"
		done

		# A relationship declared only in the body is invisible to the check
		# above, which reads Status alone.
		for number in $(awk '/^## /{inside = ($0 == "## Status")} !inside' "$file" |
			grep -oiE '(refine|supersede|extend)[sd]? (decision )?`?0[0-9]{3}' |
			grep -oE '0[0-9]{3}' | sort -u); do
			status_section "$file" | grep -q "$number-" ||
				err "$file" \
					"body declares a relationship to $number; declare it in Status, which is where the two-way check reads"
		done
	done
}

check_agent_guide
check_decision_numbers
check_decision_cross_references

exit "$fail"
